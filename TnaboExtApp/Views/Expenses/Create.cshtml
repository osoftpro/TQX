
@model TnaboExtApp.Models.Expense

@{
    ViewData["Title"] = "Add Expense";
}

<h1>Add Expense</h1>

<form asp-action="Create" method="post" class="row g-3">
    <div class="col-md-3">
        <label class="form-label">Category</label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label class="form-label">Amount</label>
        <input asp-for="Amount" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Date</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Related House</label>
        <select name="RelatedHouseId" class="form-control" asp-items="ViewBag.Houses">
            <option value="">-- None --</option>
        </select>
    </div>
    <div class="col-md-12">
        <label class="form-label">Description</label>
        <input asp-for="Description" class="form-control" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}