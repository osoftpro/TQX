
@model TnaboExtApp.Models.Payment

@{
    ViewData["Title"] = "Edit Payment";
}

<h1>Edit Payment</h1>

<form asp-action="Edit" method="post" class="row g-3">
    <input type="hidden" asp-for="Id" />
    <div class="col-md-3">
        <label class="form-label">House</label>
        <select name="HouseId" class="form-control" asp-items="ViewBag.Houses">
            <option value="">-- None --</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Amount</label>
        <input asp-for="Amount" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Amount Paid</label>
        <input asp-for="AmountPaid" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Period</label>
        <input asp-for="Period" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Payment Date</label>
        <input asp-for="PaymentDate" type="date" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Method</label>
        <input asp-for="Method" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <input asp-for="Status" class="form-control" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}