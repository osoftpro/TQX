@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 style="color: #2c3e50; margin-bottom: 10px;">Welcome to TNABO QTR Extension Portal</h2>
        <p style="color: #7f8c8d;">Manage properties, payments, and expenses efficiently</p>
    </div>
</div>

<!-- Dashboard Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <i class="fas fa-house"></i>
            <div class="stat-label">Total Houses(TQX)</div>
            <div class="stat-value">0</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card" style="border-left-color: #27ae60;">
            <i class="fas fa-money-bill-wave" style="color: #27ae60;"></i>
            <div class="stat-label">Total Payments</div>
            <div class="stat-value">0</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card" style="border-left-color: #f39c12;">
            <i class="fas fa-credit-card" style="color: #f39c12;"></i>
            <div class="stat-label">Total Expenses</div>
            <div class="stat-value">0</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card" style="border-left-color: #e74c3c;">
            <i class="fas fa-exclamation-circle" style="color: #e74c3c;"></i>
            <div class="stat-label">Pending Payments</div>
            <div class="stat-value">0</div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-bolt"></i> Quick Actions (TQX)
            </div>
            <div class="card-body">
                <div class="btn-group-vertical w-100" role="group">
                    <a href="@Url.Action("Create", "Payments")" class="btn btn-outline-primary text-start">
                        <i class="fas fa-plus"></i> Record New Payment
                    </a>
                    <a href="@Url.Action("Create", "Expenses")" class="btn btn-outline-primary text-start">
                        <i class="fas fa-plus"></i> Add Expense
                    </a>
                    <a href="@Url.Action("Create", "Houses")" class="btn btn-outline-primary text-start">
                        <i class="fas fa-plus"></i> Register House
                    </a>
                    <a href="@Url.Action("Index", "Payments")" class="btn btn-outline-primary text-start">
                        <i class="fas fa-list"></i> View All Payments
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-chart-pie"></i> System Info
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>Current Month:</strong>
                    <span class="badge bg-info">@DateTime.Now.ToString("MMMM yyyy")</span>
                </div>
                <div class="mb-3">
                    <strong>Portal Version:</strong>
                    <span>1.0.0</span>
                </div>
                <div class="mb-3">
                    <strong>Last Updated:</strong>
                    <span>@DateTime.Now.ToString("dd MMM yyyy HH:mm")</span>
                </div>
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle"></i> All data is automatically saved and backed up.
                </div>
            </div>
        </div>
    </div>
</div>