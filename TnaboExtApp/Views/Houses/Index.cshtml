@model IEnumerable<TnaboExtApp.Models.House>

@{
    ViewData["Title"] = "Index";
}

<h1 style="text-align:center">@ViewBag.StreetName HOUSES</h1>

<p>
    <a asp-action="Create" asp-route-StreetId="@ViewBag.StreetId">New Plot/House</a>
</p>

@if (ViewBag.HouseNo != null)
{
  <div class="alert alert-info" role="alert">
      <h4 class="alert-heading"><b>New House Registration Detail</b></h4>
      <hr />
      <p><b>Owner:</b> @ViewBag.OwnerName</p>
      <p><b>House No:</b> @ViewBag.HouseNo</p>
  </div>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OwnerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhaseName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StreetName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Longitude)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Latitude)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateRecorded)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OwnerName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhaseName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StreetName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HouseNo)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Longitude)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Latitude)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                @*<td>
                        @if (item.Photo != null)
                        {
                            <img src="data:image;base64,@Convert.ToBase64String(item.Photo)" width="50" height="50"/>
                        }
                        else
                        {
                            <img width="50" height="500"  />
                        }
                    </td>*@

                <td>
                    @Html.DisplayFor(modelItem => item.CreatedBy)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateRecorded)
                </td>
                <td>
                    @*<a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>|*@
                    <a asp-action="ImageCapture" asp-route-HouseId="@item.Id">Take Photo</a>
                </td>
            </tr>
        }
    </tbody>
</table>
